{
  "name": "ahmed-asl-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-metrics.mjs && next build",
    "test": "node --test --test-concurrency=1 tests/tools/*.test.js",
    "test:ml": "node --test tests/tools/ml-generator-catalog.test.js tests/tools/ml-generator-engine.test.js tests/tools/ml-generator-loader.test.js tests/tools/ml-generator-loader-validation.test.js tests/tools/ml-generator-baseline-contract.test.js tests/tools/ml-generator-parity.test.js tests/tools/ml-generator-sensor-parity.test.js tests/tools/ml-generator-edge-parity.test.js tests/tools/ml-generator.test.js tests/tools/model-mission-*.test.js",
    "test:ml:model-mission": "node --test tests/tools/model-mission-*.test.js",
    "test:ml:responsive": "node --no-warnings --test tests/tools/model-mission-responsive.test.js",
    "test:security-mission": "node --test tests/tools/security-mission-*.test.js",
    "test:security-mission:responsive": "node --no-warnings --test tests/tools/security-mission-responsive.test.js",
    "start": "next start",
    "studio": "node scripts/studio.mjs",
    "new:post": "node scripts/new-post.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "sync:scholar": "node scripts/sync-scholar-publications.mjs",
    "prepare:gradify": "node scripts/prepare-gradify.mjs",
    "test:gradify": "vitest run --config vitest.gradify.config.ts",
    "predev": "npm run prepare:gradify",
    "prebuild": "npm run prepare:gradify",
    "postbuild": "node scripts/prepare-static-segments.mjs"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.2.0",
    "html2canvas": "^1.4.1",
    "impeccable": "^3.5.0",
    "js-yaml": "5.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.24.0",
    "marked": "18.0.6",
    "next": "16.3.1",
    "pdfjs-dist": "^6.3.289",
    "postcss": "8.5.26",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-pdf": "^10.5.0",
    "recharts": "^3.9.2",
    "simple-icons": "16.27.0"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
